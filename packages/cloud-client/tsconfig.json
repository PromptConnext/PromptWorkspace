{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "sourceMap": true,
    "skipLibCheck": true,
    // Both of these are carried over from apps/vscode/tsconfig.json and must
    // stay in lockstep with it, because this package is the code those settings
    // were written for. Its consumers (apps/vscode, apps/mcp) bundle it with
    // esbuild, but its *tests* run under bare `node --test`, which type-strips
    // rather than compiles: enums, namespaces and parameter properties would
    // need a real emit, so they are banned outright rather than "avoided in the
    // tested files" — the import graph is what decides, not the file.
    "erasableSyntaxOnly": true,
    // Tests import "../src/x.ts" because that is what bare `node --test`
    // resolves, and src/ imports its siblings the same way so that a consumer
    // type-stripping this package (rather than bundling it) resolves too.
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["src", "test"],
  "exclude": ["node_modules"]
}
