{
  "name": "@promptworkspace/cloud-client",
  "version": "0.1.0",
  "private": true,
  "description": "The portable half of a PromptWorkspace task client — cloud transport, wire types, session store, retry queue, task-ref grammar and the JSON cache. No editor, no filesystem, no vscode import.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/PromptConnext/PromptWorkspace.git",
    "directory": "packages/cloud-client"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*.ts": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "assert-defaults-filled": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/assert-defaults-filled.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.2"
  }
}
