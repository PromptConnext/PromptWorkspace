{
  "name": "promptconnext",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.11.0",
  "description": "AI-native development workspace — 3S workflow (Scope → Spec → Skill) over a BYO-model orchestration engine",
  "scripts": {
    "engine": "pnpm --dir apps/engine start",
    "desktop": "pnpm --dir apps/desktop tauri dev",
    "web": "pnpm --dir apps/web dev",
    "corp": "pnpm --dir apps/corp dev",
    "vscode": "pnpm --dir apps/vscode watch"
  },
  "pnpm": {
    "overrides": {
      "@vscode/ripgrep": "1.15.9",
      "drivelist": "file:apps/desktop-theia/stubs/drivelist",
      "keytar": "file:apps/desktop-theia/stubs/keytar",
      "native-keymap": "file:apps/desktop-theia/stubs/native-keymap",
      "@wdio/native-utils": "2.5.0"
    },
    "packageExtensions": {
      "@monaco-editor/react": {
        "dependencies": {
          "@types/react": "18.3.31"
        }
      },
      "styled-jsx": {
        "dependencies": {
          "@types/react": "19.2.17"
        }
      },
      "next-intl": {
        "dependencies": {
          "@types/react": "19.2.17"
        }
      }
    }
  }
}
