# apps/cloud REST base URL (no trailing slash).
NEXT_PUBLIC_CLOUD_API_URL=http://localhost:8080
# apps/cloud presence WebSocket base (ws:// locally, wss:// in production).
NEXT_PUBLIC_CLOUD_WS_URL=ws://localhost:8080

# Must match apps/cloud's AUTH_MODE.
#   stub     — X-User-Id header, no Supabase needed (local dev/testing).
#   supabase — real Supabase Auth session, Bearer JWT.
NEXT_PUBLIC_AUTH_MODE=stub

# Only read when NEXT_PUBLIC_AUTH_MODE=supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Error reporting (plan 0021 M2). Read by both the browser and the server
# runtimes, so it has to be a NEXT_PUBLIC_ value. Left empty — the default in
# dev and in CI — Sentry.init is a no-op: nothing is captured, nothing is
# sent, and `next build` needs it no more than `next dev` does. Every report
# that does go out is scrubbed in src/lib/sentry.ts: no request headers (the
# Authorization bearer and the X-User-Id stub credential both live there), no
# request bodies, no cookies, no stack-frame locals, no console breadcrumbs,
# and every URL stripped of its query and fragment — that last one is what
# keeps Supabase's /reset-password#access_token=<JWT> recovery link and the
# /invite/<token> path out of a report.
NEXT_PUBLIC_SENTRY_DSN=
# Optional label for the Sentry "environment" facet; defaults to NODE_ENV.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
