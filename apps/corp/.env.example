# Public base URL of the marketing site (used for canonical URLs, sitemap, OG).
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://promptconnext.dev

# URL the "Sign in" / cloud signup links point to.
NEXT_PUBLIC_APP_URL=https://app.promptconnext.dev

# Latest desktop app version (shown on the /download page). MUST equal the
# version in apps/desktop/src-tauri/tauri.conf.json — it's baked into the
# Windows installer filename (PromptConnext_<version>_x64-setup.exe), so a mismatch
# gives a 404 download link.
NEXT_PUBLIC_APP_VERSION=0.1.0

# Release host for the desktop app binaries. apps/desktop CI
# (.github/workflows/desktop-build.yml) builds macOS (.app, arm64) + Windows
# (NSIS installer) via tauri-action and uploads them FLAT to a Cloudflare R2
# bucket under the "installation/" prefix. Point this at that prefix's public
# URL (no trailing slash, no version subfolder — the assets sit directly under
# it), e.g.
#   https://downloads.promptconnext.dev/installation
# Assets served: PromptConnext.app.zip and PromptConnext_<version>_x64-setup.exe.
# Leave EMPTY until the app ships — the /download page then shows a "coming
# soon" state with a "Get notified" CTA instead of dead download links.
NEXT_PUBLIC_DOWNLOAD_BASE_URL=

# Optional: where /api/contact forwards submissions (Slack/Zapier/HubSpot/CRM
# webhook). If unset, submissions are logged server-side only.
CONTACT_WEBHOOK_URL=
