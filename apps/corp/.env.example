# Public base URL of the marketing site (used for canonical URLs, sitemap, OG).
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://promptconnext.dev

# URL the "Sign in" / cloud signup links point to.
NEXT_PUBLIC_APP_URL=https://app.promptconnext.dev

# Latest desktop app version, shown as copy on the /download page. Display
# only — both installer URLs are version-free, so this is never part of a
# download link and a stale value can't send anyone to the wrong build. Leave
# it unset and the page just says "Free" instead of naming a version. Set it to
# match apps/desktop/src-tauri/tauri.conf.json when you want the number shown.
NEXT_PUBLIC_APP_VERSION=

# Release host for the desktop app binaries. apps/desktop CI
# (.github/workflows/desktop-build.yml) builds macOS (.app, arm64) + Windows
# (NSIS installer) via tauri-action and uploads them FLAT to a Cloudflare R2
# bucket under the "installation/" prefix. Point this at that prefix's public
# URL (no trailing slash, no version subfolder — the assets sit directly under
# it), e.g.
#   https://downloads.promptconnext.dev/installation
# Assets served: PromptConnext.app.zip and PromptConnext_x64-setup.exe (the
# workflow also keeps the versioned NSIS name alongside that alias).
# Leave EMPTY until the app ships — the /download page then shows a "coming
# soon" state with a "Get notified" CTA instead of dead download links.
NEXT_PUBLIC_DOWNLOAD_BASE_URL=

# Optional: where /api/contact forwards submissions (Slack/Zapier/HubSpot/CRM
# webhook). If unset, submissions are logged server-side only.
CONTACT_WEBHOOK_URL=

# Error reporting (plan 0021 M2). Read by both the browser and the server
# runtimes, so it has to be a NEXT_PUBLIC_ value. Left empty — the default in
# dev and in CI — Sentry.init is a no-op: nothing is captured, nothing is
# sent, and `next build` needs it no more than `next dev` does. Reports that
# do go out are scrubbed in src/lib/sentry.ts; on this app that matters for
# /api/contact, whose frames, request body and console logs hold a visitor's
# submission, and whose fetch failures name the CONTACT_WEBHOOK_URL above —
# that URL is redacted by value, since its secret is its own path and no
# key-name rule can see it. Verified by src/lib/sentry.test.ts (`pnpm --dir
# apps/corp test`).
NEXT_PUBLIC_SENTRY_DSN=
# Optional label for the Sentry "environment" facet; defaults to NODE_ENV.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
