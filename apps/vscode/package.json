{
  "name": "promptconnext-vscode",
  "displayName": "PromptConnext",
  "description": "Your assigned PromptConnext tasks, project context and AI coding rules, inside the editor.",
  "version": "0.1.0",
  "publisher": "promptconnext",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/9haroon/prompt-zone.git",
    "directory": "apps/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "icon": "media/prompt-connext.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onUri",
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Needs a local clone and a local git repository."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "promptconnext",
          "title": "PromptConnext",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "promptconnext": [
        {
          "id": "promptconnext.projects",
          "name": "Projects"
        },
        {
          "id": "promptconnext.tasks",
          "name": "My Tasks"
        },
        {
          "id": "promptconnext.context",
          "name": "Project Context",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "promptconnext.projects",
        "when": "!promptconnext.signedIn",
        "contents": "Sign in to see your workspaces and projects.\n[Sign in](command:promptconnext.signIn)\n\nAlready have a code from the browser?\n[Paste a sign-in code](command:promptconnext.signInWithCode)"
      },
      {
        "view": "promptconnext.projects",
        "when": "promptconnext.signedIn",
        "contents": "No workspaces yet.\n[Refresh](command:promptconnext.refreshProjects)\n\nWorkspaces and projects are created in the web app.\n[Open the web app](command:promptconnext.openProjectInWeb)"
      },
      {
        "view": "promptconnext.tasks",
        "when": "!promptconnext.signedIn",
        "contents": "Sign in to see the tasks assigned to you.\n[Sign in](command:promptconnext.signIn)\n\nAlready have a code from the browser?\n[Paste a sign-in code](command:promptconnext.signInWithCode)"
      },
      {
        "view": "promptconnext.tasks",
        "when": "promptconnext.signedIn && !promptconnext.hasActiveProject",
        "contents": "This folder is not linked to a PromptConnext project yet.\n\nPick a project to clone or open in the Projects view above, or link the folder you already have.\n[Link This Folder to a Project…](command:promptconnext.linkProject)"
      },
      {
        "view": "promptconnext.tasks",
        "when": "promptconnext.signedIn && promptconnext.hasActiveProject",
        "contents": "No tasks are assigned to you in this project.\n[Refresh](command:promptconnext.refreshTasks)\n\nPlan and assign work in the web app.\n[Open the web app](command:promptconnext.openProjectInWeb)"
      }
    ],
    "commands": [
      {
        "command": "promptconnext.signIn",
        "title": "Sign In",
        "category": "PromptConnext"
      },
      {
        "command": "promptconnext.signInWithCode",
        "title": "Sign In with a Code",
        "category": "PromptConnext"
      },
      {
        "command": "promptconnext.signOut",
        "title": "Sign Out",
        "category": "PromptConnext",
        "icon": "$(sign-out)"
      },
      {
        "command": "promptconnext.refreshTasks",
        "title": "Refresh Tasks",
        "category": "PromptConnext",
        "icon": "$(refresh)"
      },
      {
        "command": "promptconnext.setTaskStatus",
        "title": "Set Task Status…",
        "category": "PromptConnext"
      },
      {
        "command": "promptconnext.copyTaskContext",
        "title": "Copy Task Context",
        "category": "PromptConnext",
        "icon": "$(clippy)"
      },
      {
        "command": "promptconnext.openTaskInWeb",
        "title": "Open Task in the Web App",
        "category": "PromptConnext"
      },
      {
        "command": "promptconnext.openProjectInWeb",
        "title": "Open Project in the Web App",
        "category": "PromptConnext",
        "icon": "$(link-external)"
      },
      {
        "command": "promptconnext.linkProject",
        "title": "Link This Folder to a Project…",
        "category": "PromptConnext"
      },
      {
        "command": "promptconnext.flushQueue",
        "title": "Retry Pending Task Updates",
        "category": "PromptConnext"
      },
      {
        "command": "promptconnext.showLog",
        "title": "Show Log",
        "category": "PromptConnext"
      },
      {
        "command": "promptconnext.refreshProjects",
        "title": "Refresh Projects",
        "category": "PromptConnext",
        "icon": "$(refresh)"
      },
      {
        "command": "promptconnext.cloneProject",
        "title": "Clone Repository",
        "category": "PromptConnext",
        "icon": "$(repo-clone)"
      },
      {
        "command": "promptconnext.openProjectFolder",
        "title": "Open Project Folder",
        "category": "PromptConnext",
        "icon": "$(folder-opened)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "promptconnext.refreshTasks",
          "when": "view == promptconnext.tasks",
          "group": "navigation"
        },
        {
          "command": "promptconnext.signIn",
          "when": "view == promptconnext.tasks && !promptconnext.signedIn",
          "group": "1_account@1"
        },
        {
          "command": "promptconnext.signInWithCode",
          "when": "view == promptconnext.tasks && !promptconnext.signedIn",
          "group": "1_account@2"
        },
        {
          "command": "promptconnext.signOut",
          "when": "view == promptconnext.tasks && promptconnext.signedIn",
          "group": "1_account@1"
        },
        {
          "command": "promptconnext.openProjectInWeb",
          "when": "view == promptconnext.tasks && promptconnext.signedIn",
          "group": "2_open@1"
        },
        {
          "command": "promptconnext.linkProject",
          "when": "view == promptconnext.tasks && promptconnext.signedIn",
          "group": "2_open@2"
        },
        {
          "command": "promptconnext.showLog",
          "when": "view == promptconnext.tasks",
          "group": "9_diagnostics@1"
        },
        {
          "command": "promptconnext.refreshProjects",
          "when": "view == promptconnext.projects",
          "group": "navigation"
        },
        {
          "command": "promptconnext.signIn",
          "when": "view == promptconnext.projects && !promptconnext.signedIn",
          "group": "1_account@1"
        },
        {
          "command": "promptconnext.signOut",
          "when": "view == promptconnext.projects && promptconnext.signedIn",
          "group": "1_account@1"
        },
        {
          "command": "promptconnext.showLog",
          "when": "view == promptconnext.projects",
          "group": "9_diagnostics@1"
        }
      ],
      "view/item/context": [
        {
          "command": "promptconnext.cloneProject",
          "when": "view == promptconnext.projects && viewItem == promptconnext.project.remote-only",
          "group": "inline"
        },
        {
          "command": "promptconnext.openProjectFolder",
          "when": "view == promptconnext.projects && viewItem == promptconnext.project.local",
          "group": "inline"
        },
        {
          "command": "promptconnext.openProjectInWeb",
          "when": "view == promptconnext.projects && viewItem =~ /^promptconnext\\.project\\./",
          "group": "inline"
        },
        {
          "command": "promptconnext.openProjectInWeb",
          "when": "view == promptconnext.projects && viewItem =~ /^promptconnext\\.project\\./",
          "group": "1_open@1"
        },
        {
          "command": "promptconnext.copyTaskContext",
          "when": "view == promptconnext.tasks && viewItem == promptconnext.task",
          "group": "inline"
        },
        {
          "command": "promptconnext.setTaskStatus",
          "when": "view == promptconnext.tasks && viewItem == promptconnext.task"
        },
        {
          "command": "promptconnext.openTaskInWeb",
          "when": "view == promptconnext.tasks && viewItem == promptconnext.task"
        }
      ],
      "commandPalette": [
        {
          "command": "promptconnext.signIn",
          "when": "!promptconnext.signedIn"
        },
        {
          "command": "promptconnext.signInWithCode",
          "when": "!promptconnext.signedIn"
        },
        {
          "command": "promptconnext.signOut",
          "when": "promptconnext.signedIn"
        },
        {
          "command": "promptconnext.setTaskStatus",
          "when": "false"
        },
        {
          "command": "promptconnext.copyTaskContext",
          "when": "false"
        },
        {
          "command": "promptconnext.openTaskInWeb",
          "when": "false"
        },
        {
          "command": "promptconnext.openProjectInWeb",
          "when": "promptconnext.signedIn"
        },
        {
          "command": "promptconnext.cloneProject",
          "when": "false"
        },
        {
          "command": "promptconnext.openProjectFolder",
          "when": "false"
        },
        {
          "command": "promptconnext.refreshProjects",
          "when": "promptconnext.signedIn"
        }
      ]
    },
    "configuration": {
      "title": "PromptConnext",
      "properties": {
        "promptconnext.cloudApiUrl": {
          "type": "string",
          "default": "https://p01--promptconnect-cloud-api--sj64fy5ygbzy.code.run",
          "description": "Base URL of the PromptConnext cloud API."
        },
        "promptconnext.cloudWebUrl": {
          "type": "string",
          "default": "https://prompt-zone-web-app.vercel.app",
          "description": "Base URL of the PromptConnext web app, which hosts the sign-in pages."
        },
        "promptconnext.supabaseUrl": {
          "type": "string",
          "default": "",
          "description": "Supabase project URL. Leave empty to use the cloud's stub auth mode (local development only)."
        },
        "promptconnext.supabaseAnonKey": {
          "type": "string",
          "default": "",
          "description": "Supabase anon key. Required alongside supabaseUrl for real authentication."
        },
        "promptconnext.projectId": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Cloud project this folder belongs to. Set by 'Link This Folder to a Project…'; safe to commit in .vscode/settings.json — a project id is not a secret."
        },
        "promptconnext.closeTasksFromCommits": {
          "type": "boolean",
          "default": true,
          "description": "Mark a task implemented when a commit subject references it (for example 'T003: add retry')."
        },
        "promptconnext.commitScanLimit": {
          "type": "number",
          "default": 1000,
          "minimum": 10,
          "maximum": 10000,
          "description": "How far back to read commits the first time a repository is scanned, or after history is rewritten."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run typecheck && npm run build",
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/check-feature-detection.mjs",
    "test": "node --test test/unit/*.test.ts",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  }
}
