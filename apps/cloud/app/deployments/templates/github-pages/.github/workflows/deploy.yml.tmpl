# Publishes site/ to GitHub Pages and reports the result back as a GitHub
# Deployment. PromptZone reads that deployment over this repository's webhook
# and shows the live site in the project's Preview tab.
#
# This file belongs to you. Edit it freely — PromptZone seeded it once at
# repository creation and does not overwrite it.

name: Deploy preview

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

# `pages` and `id-token` are what `deploy-pages` needs; `deployments` is what
# reports the preview back to PromptZone. All three are granted to the run's
# own ephemeral token — this template has no secret of its own, which is the
# whole reason to choose it.
permissions:
  contents: read
  pages: write
  id-token: write
  deployments: write

concurrency:
  group: deploy-${{ github.ref }}
  cancel-in-progress: true

jobs:
  # Pull requests get a build check only. This template has no deploy
  # credential to leak, but the job still never publishes: a PR must not be
  # able to replace what stakeholders are reviewing.
  check:
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4
      - name: Verify the site directory is publishable
        shell: bash
        run: |
          set -euo pipefail
          test -d site || { echo "site/ is missing"; exit 1; }
          test -f site/index.html || { echo "site/index.html is missing"; exit 1; }
          echo "site/ looks publishable ($(find site -type f | wc -l) files)"

  deploy:
    if: github.event_name != 'pull_request'
    runs-on: ubuntu-latest
    # GitHub records its own Deployment in this environment. PromptZone does
    # not watch it — it filters on the `preview` environment the steps below
    # open explicitly, which is what stops a repository's own staging and
    # production workflows from being reported as the business user's preview.
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4

      # Open the PromptZone deployment first so the Preview tab can show
      # "building" while the upload runs, instead of showing nothing until it
      # finishes.
      - name: Open deployment
        id: open
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
          REPO: ${{ github.repository }}
          SHA: ${{ github.sha }}
          ENVIRONMENT: ${{ vars.PZ_ENVIRONMENT }}
          PROJECT_ID: ${{ vars.PZ_PROJECT_ID }}
        run: |
          set -euo pipefail
          deployment_id=$(gh api "repos/$REPO/deployments" \
            -f ref="$SHA" \
            -f environment="$ENVIRONMENT" \
            -f description="PromptZone preview for project $PROJECT_ID" \
            -F auto_merge=false \
            -F transient_environment=false \
            -f 'required_contexts[]' \
            --jq '.id')
          echo "id=$deployment_id" >> "$GITHUB_OUTPUT"
          gh api "repos/$REPO/deployments/$deployment_id/statuses" \
            -f state=in_progress \
            -f description="Publishing preview" >/dev/null

      # `enablement: true` turns Pages on for this repository and sets its
      # source to GitHub Actions, on the first run, using the token above — so
      # nobody has to flip a switch in repository settings and PromptZone's own
      # GitHub token needs no Pages permission.
      - name: Configure Pages
        uses: actions/configure-pages@983d7736d9b0ae728b81ab479565c72886d7745b # v5
        with:
          enablement: true

      # Upload and deploy are a matched pair — keep their majors in step when
      # you bump them.
      - name: Upload site/
        uses: actions/upload-pages-artifact@fc324d3547104276b827a68afc52ff2a11cc49c9 # v5
        with:
          path: site

      - name: Deploy to Pages
        id: deployment
        uses: actions/deploy-pages@368f82528645a54fb793d4d04e342629a3f51346 # v5

      # `always()` so a failed publish still reports a terminal state. Without
      # it a broken build looks like a preview that is forever building.
      - name: Report deployment result
        if: always() && steps.open.outputs.id != ''
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
          REPO: ${{ github.repository }}
          DEPLOYMENT_ID: ${{ steps.open.outputs.id }}
          # The URL Pages actually served this build from. PromptZone checks it
          # against the address it expects for this repository and ignores
          # anything else, so editing this to point elsewhere changes nothing
          # in the Preview tab.
          PREVIEW_URL: ${{ steps.deployment.outputs.page_url }}
          ENVIRONMENT: ${{ vars.PZ_ENVIRONMENT }}
          JOB_STATUS: ${{ job.status }}
          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
        run: |
          set -euo pipefail
          if [ "$JOB_STATUS" = "success" ]; then
            state=success
            description="Preview published"
          else
            state=failure
            description="Preview publish failed"
          fi
          gh api "repos/$REPO/deployments/$DEPLOYMENT_ID/statuses" \
            -f state="$state" \
            -f environment="$ENVIRONMENT" \
            -f environment_url="$PREVIEW_URL" \
            -f log_url="$RUN_URL" \
            -f description="$description" >/dev/null
