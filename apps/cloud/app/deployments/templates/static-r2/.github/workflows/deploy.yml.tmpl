# Publishes site/ to PromptWorkspace-managed preview storage and reports the result
# back as a GitHub Deployment. PromptWorkspace reads that deployment over this
# repository's webhook and shows the live site in the project's Preview tab.
#
# This file belongs to you. Edit it freely — PromptWorkspace seeded it once at
# repository creation and does not overwrite it.

name: Deploy preview

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

# Narrow on purpose: `deployments` is needed to report the preview URL back,
# and `contents: read` is all the checkout requires.
permissions:
  contents: read
  deployments: write

concurrency:
  # One deploy at a time per branch; a newer push supersedes an in-flight run
  # rather than racing it to the bucket.
  group: deploy-${{ github.ref }}
  cancel-in-progress: true

jobs:
  # Pull requests get a build check only, with NO access to the deploy
  # credentials. A fork's PR must never be able to read a repository secret,
  # and this job is what guarantees that: it does not reference `secrets.`
  # at all. Never convert this to `pull_request_target`.
  check:
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4
      - name: Verify the site directory is publishable
        shell: bash
        run: |
          set -euo pipefail
          test -d site || { echo "site/ is missing"; exit 1; }
          test -f site/index.html || { echo "site/index.html is missing"; exit 1; }
          echo "site/ looks publishable ($(find site -type f | wc -l) files)"

  deploy:
    if: github.event_name != 'pull_request'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4

      # Open the deployment first so PromptWorkspace can show "building" while the
      # upload runs, instead of showing nothing until it finishes.
      - name: Open deployment
        id: open
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
          REPO: ${{ github.repository }}
          SHA: ${{ github.sha }}
          ENVIRONMENT: ${{ vars.PROMPTWORKSPACE_ENVIRONMENT }}
        run: |
          set -euo pipefail
          deployment_id=$(gh api "repos/$REPO/deployments" \
            -f ref="$SHA" \
            -f environment="$ENVIRONMENT" \
            -f description="PromptWorkspace preview" \
            -F auto_merge=false \
            -F transient_environment=false \
            -f 'required_contexts[]' \
            --jq '.id')
          echo "id=$deployment_id" >> "$GITHUB_OUTPUT"
          gh api "repos/$REPO/deployments/$deployment_id/statuses" \
            -f state=in_progress \
            -f description="Publishing preview" >/dev/null

      - name: Publish site/
        shell: bash
        # Values reach the shell through env, never inline in the script — an
        # inline ${{ }} would be substituted into the command text itself.
        env:
          AWS_ACCESS_KEY_ID: ${{ secrets.PROMPTWORKSPACE_R2_ACCESS_KEY_ID }}
          AWS_SECRET_ACCESS_KEY: ${{ secrets.PROMPTWORKSPACE_R2_SECRET_ACCESS_KEY }}
          AWS_DEFAULT_REGION: auto
          BUCKET: ${{ vars.PROMPTWORKSPACE_R2_BUCKET }}
          ENDPOINT: ${{ vars.PROMPTWORKSPACE_R2_ENDPOINT }}
          PROJECT_ID: ${{ vars.PROMPTWORKSPACE_PROJECT_ID }}
        run: |
          set -euo pipefail
          aws s3 sync site "s3://$BUCKET/previews/$PROJECT_ID/" \
            --endpoint-url "$ENDPOINT" \
            --delete \
            --no-progress

      # `always()` so a failed publish still reports a terminal state. Without
      # it, a broken build would look like a preview that is forever building.
      - name: Report deployment result
        if: always() && steps.open.outputs.id != ''
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
          REPO: ${{ github.repository }}
          DEPLOYMENT_ID: ${{ steps.open.outputs.id }}
          PREVIEW_URL: ${{ vars.PROMPTWORKSPACE_PREVIEW_URL }}
          ENVIRONMENT: ${{ vars.PROMPTWORKSPACE_ENVIRONMENT }}
          JOB_STATUS: ${{ job.status }}
          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
        run: |
          set -euo pipefail
          if [ "$JOB_STATUS" = "success" ]; then
            state=success
            description="Preview published"
          else
            state=failure
            description="Preview publish failed"
          fi
          gh api "repos/$REPO/deployments/$DEPLOYMENT_ID/statuses" \
            -f state="$state" \
            -f environment="$ENVIRONMENT" \
            -f environment_url="$PREVIEW_URL" \
            -f log_url="$RUN_URL" \
            -f description="$description" >/dev/null
