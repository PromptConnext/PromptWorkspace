# PromptConnext Cloud — environment
# Copy to .env.local and fill in for a Supabase-backed run.

# Data backend: "memory" (default, no external deps) or "supabase"
DATA_BACKEND=memory

# Required only when DATA_BACKEND=supabase. SUPABASE_KEY should be the
# service_role key: end-user requests are re-scoped per-request to the
# caller's own JWT (app/dependencies.py::get_repository), so this base key
# is only used for paths with no end-user token — inbound tracker webhooks,
# the tombstone GC loop — which need real backend privileges, not an anon
# view. Never expose this key to a client.
SUPABASE_URL=
SUPABASE_KEY=

# Auth: "stub" (X-User-Id header, default) or "supabase" (verify a real
# Supabase JWT — tries JWKS at SUPABASE_URL first (current default, covers
# asymmetric ES256/RS256 tokens), falls back to SUPABASE_JWT_SECRET (legacy
# HS256) only if JWKS verification doesn't succeed).
AUTH_MODE=stub
# Legacy HS256 fallback only — SUPABASE_URL (above) covers current projects
# via JWKS. Supabase → Settings → API → JWT Settings, if you need it.
SUPABASE_JWT_SECRET=

# App
APP_ENV=development
LOG_LEVEL=INFO

# CORS — comma-separated origins the desktop app / web client may call from
CORS_ORIGINS=http://localhost:3000,http://localhost:1420

# External-tracker mirror (M5). Secrets live here (env / secret manager), never
# in the workspace row. Outbound Jira uses Basic auth (email + API token);
# inbound webhooks are HMAC-verified with the secret.
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_WEBHOOK_SECRET=

# Rate limiting (M4/M7) — token bucket per identity on /sync + webhooks.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_BURST=60

# Presence (M6) — ephemeral WebSocket who's-here.
WS_HEARTBEAT_SECONDS=20
WS_MAX_CONNECTIONS_PER_PROJECT=50

# Tombstone GC — hard-delete rows tombstoned (deleted_at) longer than this
# many days ago. Set to 0 to disable the background purge loop.
TOMBSTONE_TTL_DAYS=30
TOMBSTONE_GC_INTERVAL_SECONDS=3600

# RAG assistant v1 (M9). Required before any workspace configures a model
# connection when DATA_BACKEND=supabase — encrypts workspace-BYO model API
# keys (Fernet) so only ciphertext (`secret_ref`) is ever written to
# Postgres. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RAG_KEY_ENCRYPTION_KEY=

# Managed Thai-LLM tier (M2, plan 0007 / ADR 0013 Part B pilot) — the free
# opentyphoon.ai API as a platform-operated fallback model source for
# workspaces with no BYO connection configured. Chat only (no embeddings).
# MANAGED_MODEL_API_KEY is platform-held — never a per-user/workspace value.
MANAGED_MODEL_ENABLED=false
MANAGED_MODEL_BASE_URL=https://api.opentyphoon.ai/v1
MANAGED_MODEL_NAME=typhoon-v2.5-30b-a3b-instruct
MANAGED_MODEL_API_KEY=
MANAGED_DAILY_TOKEN_BUDGET=20000
