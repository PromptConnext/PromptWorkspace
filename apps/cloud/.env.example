# PromptZone Cloud — environment
# Copy to .env.local and fill in for a Supabase-backed run.

# Data backend: "memory" (default, no external deps) or "supabase"
DATA_BACKEND=memory

# Required only when DATA_BACKEND=supabase
SUPABASE_URL=
SUPABASE_KEY=

# Auth: "stub" (X-User-Id header, default) or "supabase" (verify HS256 JWT).
AUTH_MODE=stub
# Required when AUTH_MODE=supabase — Supabase → Settings → API → JWT Settings.
SUPABASE_JWT_SECRET=

# App
APP_ENV=development
LOG_LEVEL=INFO

# CORS — comma-separated origins the desktop app / web client may call from
CORS_ORIGINS=http://localhost:3000,http://localhost:1420

# Tombstone GC — hard-delete rows tombstoned (deleted_at) longer than this
# many days ago. Set to 0 to disable the background purge loop.
TOMBSTONE_TTL_DAYS=30
TOMBSTONE_GC_INTERVAL_SECONDS=3600
