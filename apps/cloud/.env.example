# PromptWorkspace Cloud — environment
# Copy to .env.local and fill in for a Supabase-backed run.

# Data backend: "memory" (default, no external deps) or "supabase"
DATA_BACKEND=memory

# Required only when DATA_BACKEND=supabase. SUPABASE_KEY should be the
# service_role key: end-user requests are re-scoped per-request to the
# caller's own JWT (app/dependencies.py::get_repository), so this base key
# is only used for paths with no end-user token — inbound tracker webhooks,
# the tombstone GC loop — which need real backend privileges, not an anon
# view. Never expose this key to a client.
SUPABASE_URL=
SUPABASE_KEY=

# Auth: "stub" (X-User-Id header, default) or "supabase" (verify a real
# Supabase JWT — tries JWKS at SUPABASE_URL first (current default, covers
# asymmetric ES256/RS256 tokens), falls back to SUPABASE_JWT_SECRET (legacy
# HS256) only if JWKS verification doesn't succeed).
AUTH_MODE=stub
# OPTIONAL — leave unset. Legacy HS256 fallback only; SUPABASE_URL (above)
# covers current projects via JWKS. Supabase → Settings → API → JWT Settings, if you need it.
SUPABASE_JWT_SECRET=

# App
APP_ENV=development
LOG_LEVEL=INFO

# Error reporting (plan 0021 M2). Left empty the Sentry SDK is never
# initialised at all — nothing is captured and nothing is sent, which is what
# you want locally. Set it in production: APP_ENV=production with this unset
# logs a startup warning, because a hosted instance with no error visibility
# is an operational fault. Every report is scrubbed before it leaves the
# process (app/observability.py): no stack-frame locals — which is what keeps
# a customer's source file, their decrypted model key and their GitHub PAT
# out of a report — no request bodies, no Authorization/X-User-Id headers, no
# log-record arguments, no query strings (the presence WebSocket takes
# ?token=<JWT>), and secret-bearing URL path segments redacted (the invitation
# token in POST /invitations/{token}/accept is bearer-equivalent).
SENTRY_DSN=

# CORS — comma-separated origins the desktop app / web client may call from
CORS_ORIGINS=http://localhost:3000,http://localhost:1420

# Where the web app (apps/web) is served from. Base for every invitation
# accept link: the URL emailed to the invitee (as the Supabase invite
# redirect target) and the accept_url handed back to the admin who created
# the invitation. MUST be set in production — left at this default, invite
# links point at the invitee's own machine and the invitation silently dead-
# ends. The path {WEB_APP_URL}/invite/* must also be allow-listed in Supabase
# → Authentication → URL Configuration → Redirect URLs, as a `/**` wildcard;
# bare-origin entries do not match paths beneath them and Supabase quietly
# falls back to the Site URL. See docs/DEPLOYMENT.md §2.8.
WEB_APP_URL=http://localhost:3000

# On a first authenticated GET /workspaces with ZERO memberships, mint a
# default "{user}'s workspace" with that user as admin (ADR 0015 §5), so a
# fresh account never dead-ends at the desktop membership gate. Idempotent.
# Deliberately suppressed while an invitation addressed to that user is still
# pending — otherwise an invitee gets a personal workspace minted underneath
# them and is swept into it instead of the one they were invited to. Set to
# false to stage the rollout.
AUTO_PROVISION_PERSONAL_WORKSPACE=true

# External-tracker mirror (M5). The OUTBOUND credential lives here (env /
# secret manager), never in the workspace row: Jira uses Basic auth (email +
# API token). The INBOUND webhook secret is no longer an env var — it is minted
# per Jira site when an admin configures the integration and stored encrypted
# in pw_workspace_integrations (plan 0019), because a single shared secret
# cannot tell two Atlassian tenants apart.
JIRA_EMAIL=
JIRA_API_TOKEN=

# Rate limiting (M4/M7) — token bucket per identity on /sync + webhooks.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_BURST=60

# Presence (M6) — ephemeral WebSocket who's-here.
WS_HEARTBEAT_SECONDS=20
WS_MAX_CONNECTIONS_PER_PROJECT=50

# Tombstone GC — hard-delete rows tombstoned (deleted_at) longer than this
# many days ago. Set to 0 to disable the background purge loop.
TOMBSTONE_TTL_DAYS=30
TOMBSTONE_GC_INTERVAL_SECONDS=3600

# RAG assistant v1 (M9). REQUIRED when DATA_BACKEND=supabase — the service
# refuses to start without it — encrypts workspace-BYO model API
# keys (Fernet) so only ciphertext (`secret_ref`) is ever written to
# Postgres. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RAG_KEY_ENCRYPTION_KEY=

# Git-host integration (M11). There is deliberately NO platform GitHub
# credential here: each workspace supplies its own fine-grained PAT in
# workspace settings, encrypted with RAG_KEY_ENCRYPTION_KEY above (ADR 0017
# amendment). The only server-level value needed is this service's own public
# origin, used as the callback when registering each new repo's webhook.
# Leave empty for local development — GitHub cannot reach a laptop, so webhook
# registration is skipped; repo creation and seeding still work, only PR/push
# indexing stays dormant.
# e.g. https://workspace-api.promptconnext.com (prod) or
# https://promptworkspace-api.truthledgers.com (develop).
PUBLIC_API_URL=

# --- Deployment templates (ADR 0021) ---------------------------------------
# Only the platform-hosted "Static site -> PromptWorkspace hosting" template uses
# these. Every other provider is a per-workspace credential an admin connects
# in workspace settings (PUT /workspaces/{id}/integrations/deploy/{provider},
# ADR 0023) — Vercel and the Docker-host-over-SSH template are the worked
# examples, and there is nothing platform-level to configure for any of them.
#
# DEPLOY_R2_API_TOKEN is account-wide and never leaves this service: it is used
# only to mint a per-workspace, bucket-scoped credential, and only that minted
# credential is written into a project repository. That bound matters — a repo
# secret is readable by anyone who can push to that repo, so sealing the
# account-wide token into customer repos would make one leak cross-tenant.
#
# Leave these empty and the platform-hosted template simply refuses at repo
# creation with `deployment_provider_not_configured`, rather than seeding a
# pipeline that could never succeed.
DEPLOY_R2_ACCOUNT_ID=
DEPLOY_R2_API_TOKEN=
DEPLOY_R2_ENDPOINT=
# Public base the previews are served from. Required for this template:
# without it there is no URL to hand the workflow, and repo creation refuses
# with `deployment_preview_url_not_configured`. An r2.dev address works for a
# trial but is rate-limited and documented by Cloudflare as not-for-production
# — put a custom domain in front of the bucket for real use.
#
# Note the shape mismatch this value carries today: buckets are minted one per
# workspace (`pw-preview-<workspace_id>`), but this base is a single global
# host with no bucket component — `platform_r2_preview_url()` only appends
# `/previews/<project_id>/`. That is correct for one workspace and wrong for
# two, since one host can front only one bucket. Deployments serving more than
# one workspace need a per-workspace base (or a bucket-addressing scheme)
# before a second workspace deploys.
DEPLOY_R2_PUBLIC_BASE_URL=
# Local dev only. Seals one shared key into every repo instead of minting per
# workspace. Never enable this anywhere real: a leak from any one repository
# would reach every workspace's previews.
DEPLOY_R2_ALLOW_SHARED_KEY=false
DEPLOY_R2_SHARED_ACCESS_KEY_ID=
DEPLOY_R2_SHARED_SECRET_ACCESS_KEY=
DEPLOY_R2_SHARED_BUCKET=

# --- Deployment reconciliation (ADR 0023) -----------------------------------
# The webhook is the only status channel and it is best-effort, so a lost
# delivery would otherwise leave a preview reading "building" forever. A
# periodic outbound poll closes out any non-terminal deployment older than the
# staleness threshold, asking the GitHub deployments and workflow-runs APIs
# with the workspace PAT already on file. An outbound poll, not a second
# inbound callback — ADR 0021 forbids the latter.
#
# The sweep is conservative: a deployment GitHub still reports as in flight is
# left alone however old it is. Only a terminal answer, or GitHub not knowing
# the deployment at all, closes a row out.
#
# The default staleness window is generous on purpose. A mobile build
# legitimately takes twenty minutes, and closing one out early tells a
# stakeholder their build failed when it did not — worse than closing it late.
# Set the interval to 0 to disable the sweep entirely.
DEPLOYMENT_RECONCILE_INTERVAL_SECONDS=300
DEPLOYMENT_STALE_AFTER_SECONDS=1800

# Managed Thai-LLM tier (M2, plan 0007 / ADR 0013 Part B pilot) — the free
# opentyphoon.ai API as a platform-operated fallback model source for
# workspaces with no BYO connection configured. Chat only (no embeddings).
# MANAGED_MODEL_API_KEY is platform-held — never a per-user/workspace value.
MANAGED_MODEL_ENABLED=false
MANAGED_MODEL_BASE_URL=https://api.opentyphoon.ai/v1
MANAGED_MODEL_NAME=typhoon-v2.5-30b-a3b-instruct
MANAGED_MODEL_API_KEY=
MANAGED_MODEL_MAX_TOKENS=8000

# TypeSafe System One (optional): typed judgments where a keyword scan used to
# decide — today, which runtime/services a project's plan calls for when the
# docker-compose template seeds its scaffold (app/deployments/stack_judge.py).
# Empty = keyword scan only. Platform-held, like MANAGED_MODEL_API_KEY.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
TYPESAFE_MODEL=jev-latest
MANAGED_DAILY_TOKEN_BUDGET=200000

# Managed embeddings for the assistant (M1, plan 0008) — Typhoon is chat-only,
# so a keyless workspace's content questions need a separate platform
# embedding model. Any OpenAI-compatible /embeddings endpoint works, but the
# output dimension MUST be 1536 to fit pw_rag_chunks.embedding's fixed column
# width — most open multilingual encoders do NOT fit (BGE-m3 emits 1024,
# Jina v3 1024, KaLM-embedding-multilingual v2.5 896). Known-good 1536
# options: OpenAI text-embedding-3-small (1536 native); Google
# gemini-embedding-001 via its OpenAI-compatible endpoint at
# https://generativelanguage.googleapis.com/v1beta/openai (3072 native,
# MRL-truncated to 1536 via the `dimensions` param, which HttpEmbeddingProvider
# forwards); or Alibaba-NLP/gte-Qwen2-1.5B-instruct (1536 native, Apache-2.0,
# self-hosted). Left blank, keyless status/lineage questions still work;
# content questions just skip retrieval instead of erroring.
MANAGED_EMBED_BASE_URL=
MANAGED_EMBED_MODEL=
MANAGED_EMBED_DIM=1536
MANAGED_EMBED_API_KEY=
