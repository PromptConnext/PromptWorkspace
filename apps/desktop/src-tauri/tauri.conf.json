{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PromptConnext",
  "version": "0.1.0",
  "identifier": "dev.ideva.promptconnext",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && pnpm stage:engine",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "resources": {
      ".engine-pkg": "engine"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["promptconnext"]
      }
    }
  }
}
